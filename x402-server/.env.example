# Stellar network (testnet | mainnet)
STELLAR_NETWORK=testnet

# The deployed Soroban invoice contract ID (from scripts/deploy-testnet.sh)
INVOICE_CONTRACT_ID=

# The Stellar key name (from `stellar keys ls`) used to sign contract calls
# server-side (e.g. for `mark_paid`). Defaults to "deployer".
DEPLOYER_ACCOUNT=deployer

# G... address that the server will use as a fallback "payTo" if the
# invoice creator address isn't in the request.
DEPLOYER_ADDRESS=

# USDC issuer address for the chosen network
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Frontend origin for CORS + payLink generation
FRONTEND_URL=http://localhost:3000

# Server port
PORT=4000
